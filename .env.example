# Africa ScholarBridge - example configuration. Copy values into your
# environment (Windows CMD: set NAME=value). Never commit real secrets.

# Flask session signing key - use a long random value in production.
SECRET_KEY=change-me-to-a-long-random-string

# Where the SQLite database and uploaded files live.
# Local: leave unset (database/scholarbridge.db and uploads/).
# Render (persistent disk mounted at /var/data):
# DATABASE_PATH=/var/data/scholarbridge.db
# UPLOAD_ROOT=/var/data/uploads

# Direct M-PESA visa payment (first-run defaults; afterwards edit in
# Visa Admin -> Settings)
MPESA_PHONE_NUMBER=0181785792
VISA_APPLICATION_FEE=1500

# Set to 0 in production to turn off the Flask debugger
FLASK_DEBUG=1

# Administrator email. The PASSWORD is never stored in a file - set it with:
#   python create_admin.py
ADMIN_EMAIL=africascholarbridge@gmail.com

# Optional: outgoing email (emails are skipped when these are not set)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=
# MAIL_USE_TLS=1

# Capacity monitoring (all optional - see docs/CAPACITY_MONITORING.md).
# Alerts are e-mailed with the MAIL_* settings above.
# CAPACITY_MONITOR_ENABLED=1
# CAPACITY_ALERT_EMAIL=africascholarbridge@gmail.com
# CAPACITY_ALERT_COOLDOWN_MINUTES=30
# CAPACITY_CPU_WARN=70
# CAPACITY_CPU_CRIT=85
# CAPACITY_MEMORY_WARN=70
# CAPACITY_MEMORY_CRIT=85
# CAPACITY_STORAGE_WARN=75
# CAPACITY_STORAGE_CRIT=90
# CAPACITY_ERROR_RATE_WARN=2
# CAPACITY_ERROR_RATE_CRIT=5
# CAPACITY_LATENCY_P95_WARN_MS=1500
# CAPACITY_LATENCY_P95_CRIT_MS=4000
# CAPACITY_OCR_QUEUE_WARN=3
# CAPACITY_OCR_QUEUE_CRIT=6
# Only if the dashboard says the container's limits can't be read:
# CAPACITY_MEMORY_LIMIT_MB=512
# CAPACITY_CPU_LIMIT_CORES=0.5

# Visa assistance form (funding application "No visa" path): documents that
# MUST be uploaded before the declaration. Default: photo,identity
#   photo    = Passport-size Photograph
#   identity = Valid Passport copy (or National ID if the applicant has no passport)
#   none     = every document optional
# VISA_REQUIRED_DOCUMENTS=photo,identity

# --- Separate admin subdomain (optional; leave unset until DNS is ready) ---
# When ADMIN_HOST is set, /admin and /visa-admin answer only on that host and
# return 404 on the public website. Logins are still required as before.
# ADMIN_HOST=admin.africascholarbridge.co.ke
# PUBLIC_HOST=africascholarbridge.co.ke
